<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_ledger_wizard_form" model="ir.ui.view">
        <field name="name">account.ledger.wizard.form</field>
        <field name="model">account.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Account Ledger Report">
                <group>
                    <field name="account_id"/>
                </group>

                <footer>
                    <button name="action_preview_account_report" type="object" string="Preview Report" class="btn-primary"/>

                    <button name="action_generate_account_ledger" type="object" string="Export PDF" class="btn-primary"/>

                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Account Ledger</field>
        <field name="res_model">account.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_account_ledger_report" name="Account Ledger"
              parent="account.menu_finance_reports"/>

    <menuitem id="menu_account_ledger_report_wizard" name="Account Ledger"
              parent="menu_account_ledger_report"
              action="action_account_ledger_wizard"/>
</odoo>
